# Environment variables for Asset Tracking System Backend

# Server port
PORT=3000

# SQLite Database URL
DATABASE_URL="file:./dev.db"

# Authentication secret (JWT)
JWT_SECRET="replace-this-with-a-secure-random-string-in-production"

# ThingSpeak BLE Hardware Telemetry Configuration
THINGSPEAK_CHANNEL_ID="your_channel_id_here"
THINGSPEAK_READ_API_KEY="your_read_api_key_if_private"
THINGSPEAK_POLL_INTERVAL_MS=15000
